    is +@𝐩àсàìò, 2, 'two curried positionals';
    ok @𝐩àсàìò[0].multi-invocant, 'first curried positional a multi-invocant';
    ok @𝐩àсàìò[1].multi-invocant, 'second curried positional a multi-invocant';
} #3

{
    sub 𝐩갨ò갢中갢갨丧àл($a) { }
    my @𝐩àсàìò = &𝐩갨ò갢中갢갨丧àл.signature.params;
    is +@𝐩àсàìò, 1, 'one positional';
    ok @𝐩àсàìò[0].multi-invocant, 'is positional a multi-invocant';
} #2

{
