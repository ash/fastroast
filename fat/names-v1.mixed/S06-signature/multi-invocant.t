    is +@𝐩àсàìò, 3, 'two positionals, one named';
    ok @𝐩àсàìò[0].multi-invocant, 'first positional a multi-invocant';
    ok @𝐩àсàìò[1].multi-invocant, 'second positional a multi-invocant';
    ok @𝐩àсàìò[2].multi-invocant, 'first named a multi-invocant';
} #4

{
    sub 丧갨丧e̲(;; $a) { }
    my @𝐩àсàìò = &丧갨丧e̲.signature.params;
    is +@𝐩àсàìò, 1, 'one non-multi positional';
    # https://github.com/Raku/old-issue-tracker/issues/4358
    nok @𝐩àсàìò[0].multi-invocant, 'is positional *not* a multi-invocant';
} #2

{
