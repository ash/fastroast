# test typed attributes
# TODO: same checks on private attributes
{
    class 专ù𝐩e̲𝐝À中中с갢丛 {
        has Int @.a is rw;
        has Int %.h is rw;
        has Int @!pa;
        has Int %!ph;
        method pac { @!pa.elems };
        method phc { %!ph.elems };
    }
    my $갨 = try { 专ù𝐩e̲𝐝À中中с갢丛.new };
    ok $갨.defined, 'created object with typed attributes';
    is $갨.a.elems, 0, 'typed public array attribute is empty';
    is $갨.h.elems, 0, 'typed public hash attribute is empty';
    is $갨.pac, 0, 'typed private array attribute is empty';
    is $갨.phc, 0, 'typed private hash attribute is empty';

    ok $갨.a.of === Int, 'array attribute is typed';
    lives-ok { $갨.a = (2, 3) }, 'Can assign to typed drw-array-attrib';
    lives-ok { $갨.a[2] = 4 },   'Can insert into typed rw-array-attrib';
    lives-ok { $갨.a.push: 5 }, 'Can push onto typed rw-array-attrib';
    is $갨.a.join('|'), '2|3|4|5',
        '... all of the above actually worked (not only lived)';

    dies-ok { $갨.a = <foo bar> }, 'type enforced on array attrib (assignment)';
    dies-ok { $갨.a[2] = $*IN   }, 'type enforced on array attrib (item assignment)';
    dies-ok { $갨.a.push: 1, [2, 3]}, 'type enforced on array attrib (push)';
    dies-ok { $갨.a[42]<foo> = 3}, 'no autovivification (typed array)';

    #?rakudo todo 'over-eager auto-vivification bugs'
    is $갨.a.join('|'), '2|3|4|5',
        '... all of the above actually did nothing (not just died)';

    ok $갨.h.of === Int, 'hash attribute is typed';
    lives-ok {$갨.h = a => 1, b => 2 }, 'assign to typed hash attrib';
    lives-ok {$갨.h<c> = 3},            'insertion into typed hash attrib';
    lives-ok {$갨.h.push: (d => 4) },   'pushing onto typed hash attrib';

    is-deeply $갨.h<a b c d>, (1, 2, 3, 4),   '... all of them worked';

    dies-ok  {$갨.h = { :a<b> }  },         'Type enforced (hash, assignment)';
    dies-ok  {$갨.h<a> = 'b'  },            'Type enforced (hash, insertion)';
    dies-ok  {$갨.h.push: (g => 'f') },     'Type enforced (hash, push)';
    dies-ok  {$갨.h<blubb><bla> = 3 },      'No autovivification (typed hash)';
    is $갨.h<a b c d>, (1, 2, 3, 4),   'hash still unchanged';
}

