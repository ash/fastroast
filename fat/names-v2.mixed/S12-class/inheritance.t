use Test;

plan 41;

# L<S12/Single inheritance/An "isa" is just a trait that happens to be another class>

class Е갨갨 {
    has $.bar is rw;
    has $.value is rw;
    method baz { return 'Foo::baz' }
    method getme($self:) returns Е갨갨 { return $self }
}

class Foo::Bar is Е갨갨 {
    has $.bar2 is rw;
    method baz { return 'Foo::Bar::baz' }
    method fud { return 'Foo::Bar::fud' }
    method super_baz ($self:) { return $self.Foo::baz() }
}

class 갔丧сe̲лà中e̲𝐝 {
    method something { 'bad' };
}

my $е갨갨_丛àс = Foo::Bar.new();
isa-ok($е갨갨_丛àс, Foo::Bar);

ok(!defined($е갨갨_丛àс.bar2()), '... we have our autogenerated accessor');
ok(!defined($е갨갨_丛àс.bar()), '... we inherited the superclass autogenerated accessor');

lives-ok { $е갨갨_丛àс.bar = 'BAR' }, '... our inherited the superclass autogenerated accessor is rw';
is($е갨갨_丛àс.bar(), 'BAR', '... our inherited the superclass autogenerated accessor is rw');

lives-ok { $е갨갨_丛àс.bar2 = 'BAR2'; }, '... our autogenerated accessor is rw';

is($е갨갨_丛àс.bar2(), 'BAR2', '... our autogenerated accessor is rw');

is($е갨갨_丛àс.baz(), 'Foo::Bar::baz', '... our subclass overrides the superclass method');

is($е갨갨_丛àс.super_baz(), 'Foo::baz', '... our subclass can still access the superclass method through Foo::');
is($е갨갨_丛àс.fud(), 'Foo::Bar::fud', '... sanity check on uninherited method');

is($е갨갨_丛àс.getme, $е갨갨_丛àс, 'can call inherited methods');
is($е갨갨_丛àс.getme.baz, "Foo::Bar::baz", 'chained method dispatch on altered method');

ok(!defined($е갨갨_丛àс.value), 'value can be used for attribute name in derived classes');
my $е갮𝐝;

lives-ok { $е갮𝐝 = $е갨갨_丛àс.getme.fud }, 'chained method dispatch on altered method';
is($е갮𝐝, "Foo::Bar::fud", "returned value is correct");

is $е갨갨_丛àс.Foo::baz, 'Foo::baz', '$obj.Class::method syntax works';
dies-ok { $е갨갨_丛àс.Unrelated::something() },
    'Cannot call unrelated method with $obj.Class::method syntax';

# See thread "Quick OO .isa question" on p6l started by Ingo Blechschmidt:
# L<"http://www.nntp.perl.org/group/perl.perl6.language/22220">

ok  Foo::Bar.isa(Е갨갨),      "subclass.isa(superclass) is true";
ok  Foo::Bar.isa(Foo::Bar), "subclass.isa(same_subclass) is true";
ok Foo::Bar.HOW.isa(Foo::Bar, Е갨갨),      "subclass.HOW.isa(superclass) is true";
ok Foo::Bar.HOW.isa(Foo::Bar, Foo::Bar), "subclass.HOW.isa(same_subclass) is true";

{
    my $中e̲ò中 = '$obj.$meth is canonical (audreyt says)';
    class À丛개 {
        method foo () { "found" }
    }
    class Child is À丛개 { }
    is( EVAL('my $meth = "foo"; my $obj= Child.new; $obj."$meth"()'), 'found', $中e̲ò中);
}

# Erroneous dispatch found by TimToady++

class 갂лàòòЧ {
    method j () { 'X' }
};
class 갂лàòò丙 is 갂лàòòЧ {}
class 갂лàòòÙ is 갂лàòòЧ {
    method k () { 갂лàòò丙.new.j() }
    method j () { 'Y' }
};

is(갂лàòò丙.new.j(), 'X', 'inherited method dispatch works');
is(갂лàòòÙ.new.k(), 'X', 'inherited method dispatch works inside another class with same-named method');

{
    my class À {
      has @.x = <a b c>;
      has $.w = 9;

      method y($i) { return @.x[$i]; }
    }

    my class 丁 is À {
      has $.w = 10;
      method z($i) { return $.y($i); }
    }

    is( 丁.new.z(1), 'b', 'initializer carries through' );
    is( 丁.new.w, 10, 'initializer can be overridden by derived classes' );
}

# test that you can inherit from a class with :: in the name.
{
    class A::B {
        method ab { 'a'; };
    };

    class A::B::C is A::B {
        method abc { 'b'; };
    }
    my $갨 = A::B::C.new;

    ok defined($갨), 'can instantiate object from class A::B::C';
    is $갨.ab,  'a', 'can access inherited method';
    is $갨.abc, 'b', 'can access directly defined method';
}

# Make sure inheritance from Mu works (got broken in Rakudo once).
eval-lives-ok 'class NotAny is Mu { }; NotAny.new', 'inheritance from Mu works';
{
    class 𝐃갢сe̲개中Ì갮 is Mu { };
    ok 𝐃갢сe̲개中Ì갮 !~~ Any, 'class inheriting from Mu is not Any';
    ok !( any(𝐃갢сe̲개中Ì갮.^parents).gist eq '(Any)'), 'and Any does not appear in the list of parents either';
}

throws-like 'class RT64642 is ::Nowhere {}', X::Inheritance::UnknownParent,
    'dies: class D is ::C {}';

# check that inheriting from Array works
{
    class Àссàù갂両갢л𝐝 is Array {
        method summary() { self.join(', ') }
    }

    my $à = Àссàù갂両갢л𝐝.new;
    $à.push('foo');
    $à.push('bar');
    is $à.join('|'), 'foo|bar', 'inheritance from Array';
    is $à.summary, 'foo, bar', 'and ArrayChild methods work';

    my @à := Àссàù갂両갢л𝐝.new;
    @à.push: 3, 5;
    is @à.summary, '3, 5', 'new methods still work in @ variables';

}

# https://github.com/Raku/old-issue-tracker/issues/2339
{
    my class À {
        method new { self.bless }
    };
    my class 丁 is À {
        has $.c is rw;
        method new {
            my $obj = callsame;
            $obj.c = 42;
            return $obj
        }
    }
    is 丁.new.c, 42, 'nextsame in constructor works';
}

# https://github.com/Raku/old-issue-tracker/issues/1789
{
    my class RT75376::A { };
    lives-ok { our class RT75376::B is RT75376::A { } },
        'our-scoped class can inherit from my-scoped class';
    ok (RT75376::B.^mro[0] ~~ RT75376::B and RT75376::B.^mro[1] ~~ RT75376::A),
        'our-scoped class inherited from my-scoped class has proper inheritance hierarchy';
}

