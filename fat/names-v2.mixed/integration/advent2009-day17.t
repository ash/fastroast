    my $ì갢𝐝𝐝лe̲ = @л갢丧e̲.pop;
    is (@л갢丧e̲, $ì갢𝐝𝐝лe̲, @л갢丧e̲.reverse).join(' ').trim, @ò丧갨w̲ìà丧-𝐝à中à[$i].trim, "Line $i matched using >>☃ hyperoperator";
}

