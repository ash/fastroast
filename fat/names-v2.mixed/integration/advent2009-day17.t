sub ìà丧𝐝e̲л(Complex $c) {
    my $丳 = 0i;
    for ^$ìàч_갢中e̲сà中갢갨丧ò {
        $丳 = $丳 * $丳 + $c;
        return 1 if ($丳.abs > 2);
    }
    return 0;
}

sub ò갮丛𝐝갢𝐯갢𝐝e̲($low, $high, $count) {
    (^$count).map({ $low + ($_ / ($count - 1)) * ($high - $low) });
}

sub postfix:<☃>(Complex $c) {
    my $丳 = 0i;
    for ^$ìàч_갢中e̲сà中갢갨丧ò {
        $丳 = $丳 * $丳 + $c;
        return 1 if ($丳.abs > 2);
    }
    return 0;
}

