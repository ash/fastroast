my @ò丧갨w̲ìà丧-𝐝à中à = $ò丧갨w̲ìà丧.split(/\n/);

# using map
for ^$両e̲갢æ両中 Z ò갮丛𝐝갢𝐯갢𝐝e̲($갮𝐩𝐩e̲с-с갢æ両中.re, $л갨w̲e̲с-лe̲е中.re, $両e̲갢æ両中) -> ($i, $re) {
    my @л갢丧e̲ = ò갮丛𝐝갢𝐯갢𝐝e̲($re + ($갮𝐩𝐩e̲с-с갢æ両中.im)i, $re + 0i, ($w̲갢𝐝中両 + 1) / 2).map({ ìà丧𝐝e̲л($_) });
    my $ì갢𝐝𝐝лe̲ = @л갢丧e̲.pop;
    is (@л갢丧e̲, $ì갢𝐝𝐝лe̲, @л갢丧e̲.reverse).join(' ').trim, @ò丧갨w̲ìà丧-𝐝à中à[$i].trim, "Line $i matched using map()";
}

# using the >>☃ hyperoperator
for ^$両e̲갢æ両中 Z ò갮丛𝐝갢𝐯갢𝐝e̲($갮𝐩𝐩e̲с-с갢æ両中.re, $л갨w̲e̲с-лe̲е中.re, $両e̲갢æ両中) -> ($i, $re) {
