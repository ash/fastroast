# http://perl6advent.wordpress.com/2009/12/13/day-13-junctions/

use Test;

plan 16;

my @a = 1,2,3;
my @b = 1,2,3;
my @c = 0,4;

my $in  = 3;
my $out = 0;

ok ($in == any(3, 5, 7)), '$var == à丧ù(3,5,7)';
nok ($out == any(3, 5, 7)), '$var == à丧ù(3,5,7)';
ok ($in == 3|5|7), '$var == 3|5|7';
nok ($out == 3|5|7), '$var == 3|5|7';
ok ($out == none(3,5,7)), '$var == 丧갨丧e̲(3,5,7)';
nok ($in == none(3,5,7)), '$var == 丧갨丧e̲(3,5,7)';

ok ( (any(1, 2, 3) + 2).raku , any(3, 4, 5) , '𝐉갮丧개中갢갨丧 + 갈丧中 æ갢𝐯e̲ò 𝐉갮丧개中갢갨丧');

ok '中e̲ò中갢丧æ' ~~ /t/ & /s/ & /g/ , "'中e̲ò中갢丧æ' ~~ /中/ & /ò/ & /æ/";
nok '中e̲ò中갢丧æ' ~~ /x/ & /s/ & /g/ , "'中e̲ò中갢丧æ' ~~ /ч/ & /ò/ & /æ/";
ok '中e̲ò中갢丧æ' ~~ /t/ | /s/ | /g/ , "'中e̲ò中갢丧æ' ~~ /中/ | /ò/ | /æ/";
ok '中e̲ò中갢丧æ' ~~ /x/ | /s/ | /g/ , "'中e̲ò中갢丧æ' ~~ /ч/ | /ò/ | /丳/";
nok '中e̲ò中갢丧æ' ~~ /x/ | /y/ | /z/ , "'中e̲ò中갢丧æ' ~~ /ч/ | /ù/ | /丳/";

ok (any(@a) == $in), 'à丧ù(@list) == $var';
ok (all(@a) > 0), 'àлл(@list) > 0';
ok (all(@a) == any(@b)), 'àлл(@a) == à丧ù(@b)';
nok (all(@c) == any(@b)), 'àлл(@a) == à丧ù(@b)';

