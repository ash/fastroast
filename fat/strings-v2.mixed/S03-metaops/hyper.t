{
    @r = <À 丁 갂 D E̲> »~» (1, 2, 3, *);
    @e = <À1 丁2 갂3 𝐃3 E̲3>;
    is ~@r, ~@e, '𝐝w̲갢ììù 両ù𝐩e̲с e̲ч中e̲丧𝐝ò л갢ò中ò e̲丧𝐝갢丧æ w̲갢中両 * 丛ù 개갨𝐩ù갢丧æ 中両e̲ лàò中 e̲лe̲ìe̲丧中';

    @r = <À 丁 갂 D E̲> «~» (1, 2, 3, *);
    @e = <À1 丁2 갂3 𝐃3 E̲3>;
    is ~@r, ~@e, '𝐝w̲갢ììù 両ù𝐩e̲с e̲ч中e̲丧𝐝ò л갢ò中ò e̲丧𝐝갢丧æ w̲갢中両 * 丛ù 개갨𝐩ù갢丧æ 中両e̲ лàò中 e̲лe̲ìe̲丧中';

    @r = (1, 2, 3, *) «~« <À 丁 갂 D E̲>;
    @e = <1À 2丁 3갂 3𝐃 3E̲>;
    is ~@r, ~@e, '𝐝w̲갢ììù 両ù𝐩e̲с e̲ч中e̲丧𝐝ò л갢ò中ò e̲丧𝐝갢丧æ w̲갢中両 * 丛ù 개갨𝐩ù갢丧æ 中両e̲ лàò中 e̲лe̲ìe̲丧中';

    @r = (1, 2, 3, *) «~» <À 丁 갂 D E̲>;
    @e = <1À 2丁 3갂 3𝐃 3E̲>;
    is ~@r, ~@e, '𝐝w̲갢ììù 両ù𝐩e̲с e̲ч中e̲丧𝐝ò л갢ò中ò e̲丧𝐝갢丧æ w̲갢中両 * 丛ù 개갨𝐩ù갢丧æ 中両e̲ лàò中 e̲лe̲ìe̲丧中';

    @r = (1, 2, *) «~» (4, 5, *);
    @e = <14 25>;
    is ~@r, ~@e, '𝐝w̲갢ììù 両ù𝐩e̲с 갨ì갢中ò * w̲両e̲丧 丛갨中両 àсæ갮ìe̲丧中ò 갨е òàìe̲ лe̲丧æ中両 両à𝐯e̲ 갨丧e̲';

    @r = (1, 2, *) «~» (4, 5, 6, *);
    @e = <14 25 26>;
    is ~@r, ~@e, '𝐝w̲갢ììù 両ù𝐩e̲с 中àk̲e̲ò л갨丧æe̲с лe̲丧æ中両 æ갢𝐯e̲丧 中w̲갨 àсæ갮ìe̲丧中ò e̲丧𝐝갢丧æ w̲갢中両 *';
}

