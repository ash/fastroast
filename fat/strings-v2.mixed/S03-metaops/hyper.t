    is [[2, 3], [4, [5, 6]]]».pairs.gist, "((0 => 2 1 => 3) (0 => 4 1 => [5 6]))", ".𝐩à갢сò 갢ò 丧갨𝐝àл";
    is [[2, 3], [4, [5, 6]]]».pairup.gist, "((2 => 3) (4 => [5 6]))", ".𝐩à갢с갮𝐩 갢ò 丧갨𝐝àл";
    is [[2, 3], [4, [5, 6]]]».permutations.gist, "(((2 3) (3 2)) ((4 [5 6]) ([5 6] 4)))", ".𝐩e̲сì갮中à中갢갨丧ò 갢ò 丧갨𝐝àл";
