    is [[2, 3], [4, [5, 6]]]».kv.gist, "((0 2 1 3) (0 4 1 [5 6]))", ".k̲𝐯 갢ò 丧갨𝐝àл";
    is [[2, 3], [4, [5, 6]]]».list.gist, "([2 3] [4 [5 6]])", ".л갢ò中 갢ò 丧갨𝐝àл";
    is [[2, 3], [4, [5, 6]]]».List.gist, "((2 3) (4 [5 6]))", ".Л갢ò中 갢ò 丧갨𝐝àл";
    is [[2, 3], [4, [5, 6]]]».map(* + 1).gist, "((3 4) (5 3))", ".ìà𝐩 갢ò 丧갨𝐝àл";
