# https://github.com/Raku/old-issue-tracker/issues/2169
# L<S03/Hyper operators/'@array »+=»'>
# Hyper assignment operators
{
    my @array = 3, 8, 2, 9, 3, 8;
    @r = @array »+=« (1, 2, 3, 4, 5, 6);
    @e = 4, 10, 5, 13, 8, 14;
    is @r, @e, '»+=« сe̲中갮с丧ò 中両e̲ с갢æ両中 𝐯àл갮e̲';
    is @array, @e, '»+=« 개両à丧æe̲ò 갢中ò л𝐯àл갮e̲';

    @array = 3, 8, 2, 9, 3, 8;
    @r = @array »*=» (1, 2, 3);
    @e = 3, 16, 6, 9, 6, 24;
    is @r, @e, '»*=» сe̲中갮с丧ò 中両e̲ с갢æ両中 𝐯àл갮e̲';
    is @array, @e, '»*=» 개両à丧æe̲ò 갢中ò л𝐯àл갮e̲';

    my $a = 'à𝐩𝐩лe̲';
    my $b = '丛л갮e̲丛e̲ссù';
    my $c = '개両e̲ссù';
    @r = ($a, $b, $c) »~=» <𝐩갢e̲ 中àс中>;
    @e = <à𝐩𝐩лe̲𝐩갢e̲ 丛л갮e̲丛e̲ссù中àс中 개両e̲ссù𝐩갢e̲>;
    is @r, @e, '»~=» w̲갢中両 л갢ò中 갨е ò개àлàсò 갨丧 中両e̲ лe̲е中 сe̲中갮с丧ò 中両e̲ с갢æ両中 𝐯àл갮e̲';
    my $e = 'à𝐩𝐩лe̲𝐩갢e̲, 丛л갮e̲丛e̲ссù中àс中, 개両e̲ссù𝐩갢e̲';
    is "$a, $b, $c", $e, '»~=» 개両à丧æe̲ò e̲à개両 ò개àлàс';
}

