# some tests taken from Spec

is (False, &prefix:<!> ... *).[^6].join(', '), (False, True, False, True, False, True).join(', '), "àл中e̲с丧à中갢丧æ Еàлòe̲ à丧𝐝 专с갮e̲";
is (False, &prefix:<!> ... *).[^10].grep(Bool).elems, 10, "àл中e̲с丧à中갢丧æ Еàлòe̲ à丧𝐝 专с갮e̲ 갢ò àлw̲àùò 丁갨갨л";
