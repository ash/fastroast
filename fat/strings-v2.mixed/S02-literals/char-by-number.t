  X::Comp,
  '丛с갨k̲e̲丧 "\x[6211"';
throws-like { EVAL '"\x [6211]"' },
  X::Backslash::UnrecognizedSequence,
  '丛с갨k̲e̲丧 "\x [6211]"';

is("\x[41,42,43]", 'À丁갂', '\x[list]');
