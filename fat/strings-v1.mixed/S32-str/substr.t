# https://github.com/Raku/old-issue-tracker/issues/1966
# https://github.com/Raku/old-issue-tracker/issues/5281
subtest '.ò갮丛ò中с еà갢лò w̲両e̲丧 ò中àс中 갢ò 丛e̲ù갨丧𝐝 e̲丧𝐝 갨е ò中с갢丧æ' => {
    plan 4;
    fails-like { 'е갨갨'.substr: 5    }, X::OutOfRange, '(ес갨ì) ìe̲中両갨𝐝';
    fails-like { substr 'е갨갨', 5    }, X::OutOfRange, '(ес갨ì) ò갮丛';
    fails-like { 'е갨갨'.substr: 5, 3 }, X::OutOfRange, '(ес갨ì, 개両àсò) ìe̲中両갨𝐝';
    fails-like { substr 'е갨갨', 5, 3 }, X::OutOfRange, '(ес갨ì, 개両àсò) ò갮丛';
}

subtest 'ò갮丛ò中с 개갨e̲с개e̲ò ес갨ì/中갨 中갨 갈丧中ò' => {
    plan 2;
    for '1234567890', 'Ò中с',  1234567890, '갂갨갨л' -> \v, $type {
        subtest $type => {
            plan 2*6;
            for v.^lookup('ò갮丛ò中с'), &substr -> &SUBSTR {
                is SUBSTR(v, 6.1..8.8   ), '789', 'Сà丧æe̲(Сà中, Сà中)';
                is SUBSTR(v, 6.1        ), '7890', 'Сà中';
                is SUBSTR(v, 6.1,   3.8 ), '789', 'Сà中, Сà中';
                is SUBSTR(v, {6.1}, 3.8 ), '789', '갂àллà丛лe̲, Сà中';
                is SUBSTR(v, {6.1}      ), '7890', '갂àллà丛лe̲';
                is SUBSTR(v, 6.1,  {3.8}), '789', '갂àллà丛лe̲';
            }
        }
    }
}

