{ # ranges

    my $str = "両e̲лл갨 е갨갨 à丧𝐝 丛àс";

    is substr($str, 6..8), "е갨갨", "ò갮丛ò中с (ò갮丛ò中с(Сà丧æe̲))";
    is $str.substr(6..8),  "е갨갨", "ò갮丛ò中с (ò갮丛ò中с(Сà丧æe̲))";

    is substr($str, 6^..8), "갨갨", "ò갮丛ò中с (ò갮丛ò中с(^Сà丧æe̲))";
    is $str.substr(6^..8),  "갨갨", "ò갮丛ò中с (ò갮丛ò中с(^Сà丧æe̲))";

    is substr($str, 6..^8), "е갨", "ò갮丛ò中с (ò갮丛ò中с(Сà丧æe̲^))";
    is $str.substr(6..^8),  "е갨", "ò갮丛ò中с (ò갮丛ò中с(Сà丧æe̲^))";

    is substr($str, 6^..^8), "갨", "ò갮丛ò中с (ò갮丛ò中с(^Сà丧æe̲^))";
    is $str.substr(6^..^8),  "갨", "ò갮丛ò中с (ò갮丛ò中с(^Сà丧æe̲^))";

    is substr($str, 10..*), "à丧𝐝 丛àс", "ò갮丛ò中с (ò갮丛ò中с(Сà丧æe̲ 갈丧е))";
    is $str.substr(10..*),  "à丧𝐝 丛àс", "ò갮丛ò中с (ò갮丛ò中с(Сà丧æe̲ 갈丧е))";
}

