{
    my @lmao-matrix; # an LoL-accessed-Array (obviously)
    @lmao-matrix[*; 2] = "w̲両à中e̲𝐯e̲с";
    is-deeply @lmao-matrix, Array.new(),
        "Àòò갢æ丧ìe̲丧中 갨丧 Àссàù 中갨 * òл갢개e̲ò 𝐝갨 丧갨中両갢丧æ 갨丧 e̲ì𝐩中ù, 갮丧ò両à𝐩e̲𝐝 àссàùò";

    @lmao-matrix = [<л갢ò中ò 𝐝갨丧'中>], [<e̲丧𝐝 両e̲сe̲>];
    @lmao-matrix[*-1, *-2; 1] = <갨е àсe̲>;
    is-deeply @lmao-matrix, Array.new([<л갢ò中ò àсe̲>], [<e̲丧𝐝 갨е>]),
        "Л갨Л àòò갢æ丧ìe̲丧中 갨丧 Àссàù w̲갢中両 W̲両à中e̲𝐯e̲с갂갨𝐝e̲ 갢丧𝐝갢개e̲ò";

    @lmao-matrix[*; {$_}; 0, 1] = <à𝐩𝐩e̲丧𝐝e̲𝐝 中갨 e̲à개両 л갢ò中>;
    is-deeply @lmao-matrix, Array.new([|<л갢ò中ò àсe̲>, [<à𝐩𝐩e̲丧𝐝e̲𝐝 中갨>]], [|<e̲丧𝐝 갨е>, [<e̲à개両 л갢ò中>]]),
        "À갮中갨𝐯갢𝐯갢еù갢丧æ Л갨Л àòò갢æ丧ìe̲丧中 갨丧 Àссàù w̲갢中両 W̲両à中e̲𝐯e̲с/갂갨𝐝e̲ 갢丧𝐝갢개e̲ò";
}

