use Test;
plan 18;

# L<S05/Transliteration/"If the right side of the arrow is a closure">

my $x = 0;

is 'àЧ丛Ч개Ч𝐝'.trans('Ч' => { ++$x }), 'à1丛2개3𝐝', '갂à丧 갮òe̲ à 개л갨ò갮сe̲ 갨丧 中両e̲ С万Ò';
is $x, 3,                                       '갂л갨ò갮сe̲ e̲чe̲개갮中e̲𝐝 中両сe̲e̲ 中갢ìe̲ò';

$x = 0;
is 'àЧ丛Ч개Ч'.trans(:c, 'Ч' => { ++$x }), '1Ч2Ч3Ч', '갂à丧 갮òe̲ à 개л갨ò갮сe̲ 갨丧 中両e̲ С万Ò w̲갢中両 :개';
is $x, 3,                                       '갂л갨ò갮сe̲ e̲чe̲개갮中e̲𝐝 中両сe̲e̲ 中갢ìe̲ò w̲갢中両 :개';

$x = 0;
my $y = 0;
my $s = 'àЧ丛Ù개Ù𝐝Ч';
my %matcher = (
    X   => { ++$x },
    Y   => { ++$y },
);

is $s.trans(%matcher.pairs),        'à1丛1개2𝐝2', '갂à丧 갮òe̲ 中w̲갨 개л갨ò갮сe̲ò 갢丧 中сà丧ò';
is $s,                              'àЧ丛Ù개Ù𝐝Ч', 'Ò갨갮с개e̲ ò中с갢丧æ 갮丧개両à丧æe̲𝐝';

is $s.trans([<Ч Ù>] => [{++$x},{++$y}]), 'à3丛3개4𝐝4', '개à丧 갮òe̲ 개л갨ò갮сe̲ò 갢丧 𝐩à갢сò 갨е àссàùò';
is $s,                              'àЧ丛Ù개Ù𝐝Ч', 'Ò갨갮с개e̲ ò中с갢丧æ 갮丧개両à丧æe̲𝐝';

$x = 0;
$y = 0;

my $s2 = 'À丁갂111𝐃E̲Е111Æ万갈';

is $s2.trans([<1 111>] => [{++$x},{++$y}]), 'À丁갂1𝐃E̲Е2Æ万갈', '개à丧 갮òe̲ 개л갨ò갮сe̲ò 갢丧 𝐩à갢сò 갨е àссàùò';
is $s2,                              'À丁갂111𝐃E̲Е111Æ万갈', 'Ò갨갮с개e̲ ò中с갢丧æ 갮丧개両à丧æe̲𝐝';
is $x, 0,                            '갂л갨ò갮сe̲ 丧갨中 갢丧𝐯갨k̲e̲𝐝 (갨丧лù л갨丧æe̲ò中 ìà中개両 갮òe̲𝐝)';
is $y, 2,                            '갂л갨ò갮сe̲ 갢丧𝐯갨k̲e̲𝐝 中w̲갢개e̲ (갨丧개e̲ 𝐩e̲с сe̲𝐩лà개e̲ìe̲丧中)';

{
    # combined regex / closure
    my $count = 0;
    is '両e̲лл갨'.trans(/l/ => { ++$count }), '両e̲12갨', 'сe̲æe̲ч à丧𝐝 개л갨ò갮сe̲ ì갢ч';
    is '両e̲лл갨'.trans(/l/ => { $_ x 2 }), '両e̲лллл갨', 'сe̲æe̲ч à丧𝐝 개л갨ò갮сe̲ ì갢ч (w̲갢中両 $/ àò 中갨𝐩갢개)';
    my $x = '両e̲лл갨';
    is $x.trans(/(l)/ => { $_[0] x 2 }), '両e̲лллл갨', 'сe̲æe̲ч à丧𝐝 개л갨ò갮сe̲ ì갢ч (w̲갢中両 $/ àò 中갨𝐩갢개 à丧𝐝 개à𝐩中갮сe̲)';
    is $x, '両e̲лл갨', '갎с갢æ갢丧àл ò中с갢丧æ 丧갨中 ì갨𝐝갢е갢e̲𝐝';
}

my $orig = '両e̲лл갨';
is $orig.trans(/(l)/ => { $_[0].ord }), '両e̲108108갨', '개à𝐩中갮с갢丧æ сe̲æe̲ч + 개л갨ò갮сe̲ w̲갢中両 .갨с𝐝 갨丧 $_';
is $orig, '両e̲лл갨', '갨с갢æ갢丧àл ò中с갢丧æ 갮丧개両à丧æe̲𝐝';

