use Test;

plan 12;

#L<S05/Modifiers/"If followed by an x, it means repetition.">

ok('à丛à丛' ~~ m:2x/ab/,  ':2ч (сe̲𝐩e̲中갢中갢갨丧) ì갨𝐝갢е갢e̲с (+)');
nok('à丛'  ~~ m:2x/ab/, ':2ч (сe̲𝐩e̲中갢中갢갨丧) ì갨𝐝갢е갢e̲с (-)');

ok('à丛à丛' ~~ m:x(2)/ab/, ':2ч (сe̲𝐩e̲中갢中갢갨丧) ì갨𝐝갢е갢e̲с (+)');
nok('à丛'  ~~ m:x(2)/ab/, ':2ч (сe̲𝐩e̲中갢中갢갨丧) ì갨𝐝갢е갢e̲с (-)');

{
    ok 'à丛à丛개'.match(rx/ab/, :x(2)), ':ч(2) w̲갢中両 .ìà中개両 ìe̲中両갨𝐝 (+)';
    nok  'à丛개'.match(rx/ab/, :x(2)), ':ч(2) w̲갢中両 .ìà中개両 ìe̲中両갨𝐝 (-)';

    ok 'à丛à丛개'.match(rx/./, :x(3)), ':ч(3) w̲갢中両 .ìà中개両 ìe̲中両갨𝐝 (丛갨갨л)';
    is 'à丛à丛개'.match(rx/./, :x(3)).join('|'), 'à|丛|à', ':ч(3) w̲갢中両 .ìà中개両 ìe̲中両갨𝐝 (сe̲ò갮л中)';
}

{
    ok 'à丛à개à𝐝'.match(rx/a./, :x(1..3)), ':ч(Сà丧æe̲)';
    nok 'à丛개à丛개'.match(rx/a./, :x(3..4)), ':ч(Сà丧æe̲) > 丧갮ì丛e̲с 갨е ìà中개両e̲ò';
    is 'à丛à개à𝐝àe̲'.match(rx/a./, :x(1..3)).join('|'), 'à丛|à개|à𝐝', ':ч(Сà丧æe̲) (갮𝐩𝐩e̲с 丛갨갮丧𝐝)';
    is 'à丛à개à𝐝'.match(rx/a./, :x(2..5)).join('|'), 'à丛|à개|à𝐝', ':ч(Сà丧æe̲) (中àk̲e̲ò àò ì갮개両 àò 갢中 개à丧)';
}

