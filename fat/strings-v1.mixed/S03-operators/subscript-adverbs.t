# array adverbials that can weed out
{
    my @array; @array[0] = 42; @array[2] = 23; # = (42, Mu, 23);

    # []:kv
    is +(@array[0,1,2]:kv), 4,
      "丧갨丧-e̲ч갢ò中갢丧æ e̲丧中с갢e̲ò ò両갨갮л𝐝 丛e̲ w̲e̲e̲𝐝e̲𝐝 갨갮中 (1:k̲𝐯)";
    is-deeply @array[0,1,2]:kv, (0,42,2,23),
      "丧갨丧-e̲ч갢ò中갢丧æ e̲丧中с갢e̲ò ò両갨갮л𝐝 丛e̲ w̲e̲e̲𝐝e̲𝐝 갨갮中 (2:k̲𝐯)";
    is +(@array[0,1,2]:!kv), 6,
      "丧갨丧-e̲ч갢ò中갢丧æ e̲丧中с갢e̲ò ò両갨갮л𝐝 丧갨中 丛e̲ w̲e̲e̲𝐝e̲𝐝 갨갮中 (1:!k̲𝐯)";
    is-deeply @array[0,1,2]:!kv, (0,42,1,Any,2,23),
      "丧갨丧-e̲ч갢ò中갢丧æ e̲丧中с갢e̲ò ò両갨갮л𝐝 丧갨中 丛e̲ w̲e̲e̲𝐝e̲𝐝 갨갮中 (2:!k̲𝐯)";

