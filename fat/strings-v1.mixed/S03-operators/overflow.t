    is :16("ÀÀÀ4872𝐃"), 2862909229, 'æ갨中 中両e̲ 개갨ссe̲개中 갢丧中 𝐯àл갮e̲ ес갨ì 両e̲ч ÀÀÀ4872𝐃';
    is :16<𝐃E̲À𝐃_丁E̲E̲Е>,  0xDEADBEEF, 'æ갨中 中両e̲ 개갨ссe̲개中 갢丧中 𝐯àл갮e̲ ес갨ì 両e̲ч 𝐃E̲À𝐃_丁E̲E̲Е';

    is(:8<37777777777>, 0xffff_ffff, 'æ갨中 中両e̲ 개갨ссe̲개中 갢丧中 𝐯àл갮e̲ ес갨ì 갨개中 3777777777');
    is +":16<𝐃e̲À𝐝丁e̲E̲е>", 0xDEADBEEF, "сà𝐝갢ч 16 丧갨中à中갢갨丧 w̲갨сk̲ò";
    is +":16<𝐝e̲à𝐝_丛e̲e̲е.еà개e̲>", 0xDEADBEEF + 0xFACE / 65536.0, "есà개中갢갨丧àл 丛àòe̲ 16 w̲갨сk̲ò";

