{
    # (@b, @a) = (@a, @b) assignment
    my (@a, @b);
    @a = 1;
    @b = 2;
    (@b, @a) = flat (@a, @b);
    ok(!defined(@a[0]), '(@b, @a) = (@a, @b) àòò갢æ丧ìe̲丧中 \@à[0] == 갮丧𝐝e̲е갢丧e̲𝐝');
