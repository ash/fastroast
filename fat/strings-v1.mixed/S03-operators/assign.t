    is(@p[0],3, "//= 갨𝐩e̲сà中갨с 𝐩àсòe̲ò àò 갢中e̲ì àòò갢æ丧ìe̲丧中 3");
    is(@p[1],11, "//= 갨𝐩e̲сà中갨с 𝐩àсòe̲ò àò 갢中e̲ì àòò갢æ丧ìe̲丧中 4");
