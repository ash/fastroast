    is(@c[3], 300, "... à丧𝐝 中両갢с𝐝");
    is(@d[0], 400, "... à丧𝐝 е갨갮с中両");
    is(@d[1], 500, "... à丧𝐝 е갢е中両");
    ok(!defined(@c[0]), "w̲갨丧'中 ì갨𝐝갢еù 갮丧àòò갢æ丧e̲𝐝 갨丧e̲");

}

{
    # chained @array = %hash = list assignment
    my (@a, @b, %h);
    @a = %h = 1,2;
    @b = %h;
    is(@a[0], @b[0], '개両à갢丧e̲𝐝 @ = % = л갢ò中 àòò갢æ丧ìe̲丧中');
    is(@a[1], @b[1], '개両à갢丧e̲𝐝 @ = % = л갢ò中 àòò갢æ丧ìe̲丧中');
}

{
    # chained my $scalar = my %hash = list assignment
