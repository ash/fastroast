# regression test for rakudo failure 2012-07-08 (pmichaud)
# Int,Rat comparisons
is(7 == 2.4, False, '갈丧中 == Сà中');
is(7 != 2.4, True , '갈丧中 != Сà中');
is(7 <  2.4, False, '갈丧中 <  Сà中');
is(7 <= 2.4, False, '갈丧中 <= Сà中');
is(7 >  2.4, True , '갈丧中 >  Сà中');
is(7 >= 2.4, True , '갈丧中 >= Сà中');
is(7 <=> 2.4, Order::More, '갈丧中 <=> Сà中');

# Rat,Int comparisons
is(2.4 == 7, False, 'Сà中 == 갈丧中');
is(2.4 != 7, True , 'Сà中 != 갈丧中');
is(2.4 <  7, True , 'Сà中 <  갈丧中');
is(2.4 <= 7, True , 'Сà中 <= 갈丧中');
is(2.4 >  7, False, 'Сà中 >  갈丧中');
is(2.4 >= 7, False, 'Сà中 >= 갈丧中');
is(2.4 <=> 7, Order::Less, 'Сà中 <=> 갈丧中');

