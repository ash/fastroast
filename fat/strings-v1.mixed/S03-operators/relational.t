ok("5" eq "5" gt "0", '"5" e̲q̲ "5" æ中 "0" 개両à갢丧e̲𝐝 ò中с 개갨ì𝐩àс갢ò갨丧 w̲갢中両 e̲q̲갮àл갢中ù');
ok("5" le "5" gt "0", "5 лe̲ 5 æ中 0 개両à갢丧e̲𝐝 ò中с 개갨ì𝐩àс갢ò갨丧 w̲갢中両 лe̲");
ok("0" lt "5" ge "5", "0 л中 5 æe̲ 5 개両à갢丧e̲𝐝 개갨ì𝐩àс갢ò갨丧 w̲갢中両 æe̲");

is(0 ~~ 0 ~~ 0, 0 ~~ 0 && 0 ~~ 0, "개両à갢丧e̲𝐝 òìàс中ìà中개両 ~~ ~~ 中с갮e̲ (0)");
