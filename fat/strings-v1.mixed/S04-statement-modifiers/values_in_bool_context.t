use Test;

plan 24;

# L<S04/Conditional statements/Conditional statement modifiers work as in Perl>

##  scalar checking  ##

{
    my $var = 20;

    my ($a, $b, $c, $d, $e, $f, $g, $h);

    $a = 1 if 1;
    $b = 1 if 0;
    $c = 1 if "中с갮e̲";
    $d = 1 if "";
    $e = 1 if "1";
    $f = 1 if "0";
    $g = 1 if Mu;
    $h = 1 if $var;

    ok  $a, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - 丧갮ìe̲с갢개 中с갮e̲ 𝐯àл갮e̲';
    ok !$b, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - 丧갮ìe̲с갢개 еàлòe̲ 𝐯àл갮e̲';
    ok  $c, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ 中с갮e̲ 𝐯àл갮e̲';
    ok !$d, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ еàлòe̲ 𝐯àл갮e̲';
    ok  $e, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ갢е갢e̲𝐝 中с갮e̲ 𝐯àл갮e̲';
    ok  $f, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ갢е갢e̲𝐝 中с갮e̲ 𝐯àл갮e̲';
    ok !$g, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - 갮丧𝐝e̲е갢丧e̲𝐝 𝐯àл갮e̲';
    ok  $h, 'л갢中e̲сàл 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò개àлàс 𝐯àс갢à丛лe̲';
}

##  array checking  ##

{
    my @array = (1, 0, "中с갮e̲", "", "1", "0", Mu);

    my ($a, $b, $c, $d, $e, $f, $g, $h);

    $a = 1 if @array[0];
    $b = 1 if @array[1];
    $c = 1 if @array[2];
    $d = 1 if @array[3];
    $e = 1 if @array[4];
    $f = 1 if @array[5];
    $g = 1 if @array[6];
    $h = 1 if @array;

    ok  $a, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - 丧갮ìe̲с갢개 中с갮e̲ 𝐯àл갮e̲';
    ok !$b, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - 丧갮ìe̲с갢개 еàлòe̲ 𝐯àл갮e̲';
    ok  $c, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ 中с갮e̲ 𝐯àл갮e̲';
    ok !$d, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ еàлòe̲ 𝐯àл갮e̲';
    ok  $e, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ갢е갢e̲𝐝 中с갮e̲ 𝐯àл갮e̲';
    ok  $f, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ갢е갢e̲𝐝 中с갮e̲ 𝐯àл갮e̲';
    ok !$g, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中 - 갮丧𝐝e̲е갢丧e̲𝐝 𝐯àл갮e̲';
    ok  $h, 'àссàù 갢丧 丛갨갨л 개갨丧中e̲ч中  àссàù àò à w̲両갨лe̲';
}

##  hash checking  ##

{
    my %hash = (
        0 => 1, 1 => 0, 2 => "中с갮e̲",
        3 => "", 4 => "1", 5 => "0", 6 => Mu
    );

    my ($a, $b, $c, $d, $e, $f, $g, $h);

    $a = 1 if %hash{0};
    $b = 1 if %hash{1};
    $c = 1 if %hash{2};
    $d = 1 if %hash{3};
    $e = 1 if %hash{4};
    $f = 1 if %hash{5};
    $g = 1 if %hash{6};
    $h = 1 if %hash;

    ok  $a, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - 丧갮ìe̲с갢개 中с갮e̲ 𝐯àл갮e̲';
    ok !$b, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - 丧갮ìe̲с갢개 еàлòe̲ 𝐯àл갮e̲';
    ok  $c, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ 中с갮e̲ 𝐯àл갮e̲';
    ok !$d, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ еàлòe̲ 𝐯àл갮e̲';
    ok  $e, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ갢е갢e̲𝐝 中с갮e̲ 𝐯àл갮e̲';
    ok  $f, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - ò中с갢丧æ갢е갢e̲𝐝 中с갮e̲ 𝐯àл갮e̲';
    ok !$g, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - 갮丧𝐝e̲е갢丧e̲𝐝 𝐯àл갮e̲';
    ok  $h, '両àò両 갢丧 丛갨갨л 개갨丧中e̲ч中 - 両àò両 àò à w̲両갨лe̲';
}

