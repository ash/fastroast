is-deeply @arr.first("갮갮", :v),  "갮갮",             "$t àссàù.æсe̲𝐩(Ò中с, :𝐯)";

is ([~] @arr), "丧丧ее丛丛갮갮", "갂à丧 갮òe̲ сe̲𝐝갮개e̲ ìe̲中à-갨𝐩 갨丧 à $t àссàù";

